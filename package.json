{
  "name": "everforest",
  "displayName": "Everforest",
  "description": "Comfortable & Pleasant Color Scheme for Visual Studio Code",
  "version": "1.0.0",
  "publisher": "haru",
  "author": "haru (https://github.com/Haruno19)",
  "homepage": "https://github.com/Haruno19/everforest-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/Haruno19/everforest-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Haruno19/everforest-vscode/issues"
  },
  "license": "MIT",
  "keywords": [
    "green",
    "theme"
  ],
  "galleryBanner": {
    "color": "#2f383e",
    "theme": "dark"
  },
  "categories": [
    "Themes"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "themes": [
      {
        "label": "Everforest Higure",
        "uiTheme": "vs-dark",
        "path": "./themes/everforest-higure.json"
      },
      {
        "label": "Everforest Yoake",
        "uiTheme": "vs",
        "path": "./themes/everforest-yoake.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "rimraf dist *.vsix",
    "compile:ts": "tsc",
    "compile:themes": "node dist/hook/generateThemes.js",
    "compile": "npm run clean && npm run compile:ts && npm run compile:themes",
    "package": "vsce package && git checkout -- themes",
    "lint": "eslint . --ext .ts",
    "browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. .",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.{js,json,md}": "prettier --write"
  },
  "engines": {
    "vscode": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "18.11.14",
    "@types/vscode": "1.55.0",
    "@typescript-eslint/eslint-plugin": "5.46.1",
    "@typescript-eslint/parser": "5.46.1",
    "@vscode/test-web": "0.0.33",
    "@vscode/vsce": "^2.15.0",
    "eslint": "8.29.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "4.2.1",
    "husky": "8.0.2",
    "lint-staged": "13.1.0",
    "prettier": "2.8.1",
    "rimraf": "3.0.2",
    "typescript": "4.9.4"
  }
}
